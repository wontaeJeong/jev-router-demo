# Generative LLM Router - LiteLLM (OpenAI compatible)
LLM_BASE_URL=http://localhost:4000/v1
# Leave empty if the local endpoint requires no authentication.
LLM_API_KEY=sk-local
LLM_MODEL=my-routing-model

# Jev Router - typed System One API (recommended)
JEV_API_MODE=systemone
JEV_ENDPOINT_URL=https://openrouter.ai/api/v1/systemone
JEV_API_KEY=
JEV_MODEL=typesafe/jev-1.13
# Decisions API uses the same typed state/questions/answers contract:
# JEV_API_MODE=decisions
# JEV_ENDPOINT_URL=https://openrouter.ai/api/alpha/decisions
# A local System One server can instead use JEV_BASE_URL=http://localhost:8001
# (the adapter appends /v1/systemone); the key is optional for local servers.
# Legacy generated fallback (not a real typed Jev API):
# JEV_API_MODE=ollama
# JEV_ENDPOINT_URL=
# JEV_BASE_URL=http://localhost:11434
# JEV_MODEL=jev-like

# Common (seconds)
REQUEST_TIMEOUT=60
