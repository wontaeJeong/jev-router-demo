Screen { background: #0b1220; color: #d9e3f0; }
#brand { height: 1; padding: 0 2; background: #142135; }
#subtitle { height: 1; padding: 0 2; color: #8c9bb2; }
.toolbar { height: 3; margin: 1 2 0 2; }
#scenario { width: 1fr; margin-right: 1; }
.toolbar Button { margin-left: 1; min-width: 12; }
#request-preview-scroll { height: 3; margin: 0 2; padding: 0 1; border-left: thick #536881; }
#request-preview-scroll:focus { border-left: thick #60b9f0; }
#request-preview { height: auto; }
#views { height: 1fr; margin: 0 1; }
TabPane { padding: 1; }
#cards, #probability-cards, #execution-cards { height: auto; }
.result-card { width: 1fr; height: auto; padding: 1 2; margin: 0 1 1 0; background: #142135; }
.llm { border-top: thick #60b9f0; }
.jev { border-top: thick #6fdaa8; }
#probability-cards.narrow, #execution-cards.narrow, .decision-pair.narrow { layout: vertical; }
.narrow .result-card { width: 100%; padding: 1; }
.router-heading { width: 1fr; height: 4; padding: 0 1; background: #142135; margin-right: 1; }
.decision-pair { height: auto; }
.candidate-cell { width: 1fr; height: auto; padding: 0 1; background: #142135; margin-right: 1; border-top: none; }
.decision-pair.narrow .candidate-cell { width: 100%; }
.question-heading { height: 1; margin-top: 1; }
#key-metrics { margin-top: 1; }
#comparison-scroll { height: 1fr; }
.stacked .router-heading { height: 3; }
.stacked #subtitle { display: none; }
#request-original-scroll { height: 1fr; }
#request-original { height: auto; padding: 0 1 1 1; }
#comparison-summary { height: auto; padding: 1; background: #1b2a3e; }
.note { height: auto; color: #93a4bc; padding: 1; }
#router { width: 20; }
#http-meta { height: auto; padding: 1; color: #93a4bc; }
#json-log { height: 1fr; background: #101a2a; border: solid #32475f; }
#json-log:focus { border: solid #60b9f0; }
#status { height: 2; padding: 0 2; color: #6fdaa8; }
Footer { background: #142135; }
RequestEditor { align: center middle; background: #000000 65%; }
#editor-dialog { width: 85%; height: 75%; padding: 1 2; background: #142135; border: solid #60b9f0; }
#editor-dialog Label { height: 2; }
#request-editor { height: 1fr; }
.compact .toolbar { margin: 0 1; }
.compact #request-preview-scroll { height: 3; margin: 0 1; }
.detail-view #request-preview-scroll { display: none; }
.compact #http-meta { height: 1; padding: 0; }
.compact #preview-label { height: 1; padding: 0; }
.compact #status { height: 1; }
ScenarioPicker { align: center middle; background: #000000 65%; }
#picker-dialog { width: 90%; height: 85%; padding: 1 2; background: #142135; border: solid #60b9f0; }
#picker-title { height: 2; }
#picker-filters { height: 3; }
#scenario-category { width: 28; margin-right: 1; }
#scenario-search { width: 1fr; }
#picker-count { height: 1; color: #93a4bc; }
#picker-body { height: 1fr; }
#scenario-list { width: 1fr; height: 1fr; }
#picker-preview-scroll { width: 1fr; padding: 1; }
#picker-preview { height: auto; }
#picker-actions { height: 3; margin-top: 1; }
#picker-actions Button { min-width: 10; margin-right: 1; }
.picker-narrow #picker-dialog { width: 96%; height: 95%; padding: 0 1; }
.picker-narrow #picker-filters { layout: vertical; height: 6; }
.picker-narrow #scenario-category, .picker-narrow #scenario-search { width: 100%; }
.picker-narrow #picker-body { layout: vertical; }
.picker-narrow #scenario-list { width: 100%; height: 1fr; }
.picker-narrow #picker-preview-scroll { width: 100%; height: 5; padding: 0 1; }
.picker-short #picker-preview-scroll { display: none; }
